# BreatheWise AI Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real API keys.

# Application environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI Provider Configuration
# Supported values: none (deterministic fallback), openai, gemini
AI_PROVIDER=none

# Optional OpenAI API key (server-side only; required only if AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional Google Gemini API key (server-side only; required only if AI_PROVIDER=gemini)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# Optional External Air Quality API override (defaults to Open-Meteo Air Quality API)
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Optional Distributed Rate Limiting (Upstash Redis REST)
# If omitted, falls back to single-instance token-bucket limiting (not globally consistent across serverless instances).
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

