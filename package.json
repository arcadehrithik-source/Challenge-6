    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^16.4.6",
