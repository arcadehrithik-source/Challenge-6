{
  "name": "breathewise-ai",
  "version": "1.0.0",
  "private": true,
  "description": "BreatheWise AI - Context-aware urban air quality decision assistant (Challenge 6: PromptWars)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
